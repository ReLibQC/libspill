# Build products. Patterns rather than names: renaming a target used to leave
# its old binary behind for `git add -A` to find, which is how libscratch.a and
# tests/churn_libscratch reached a commit.
*.a
*.o
*.d
*.mod
*.so
*.so.*

# out-of-source build directories
build/
_build/
cmake-build*/
prefix/

tests/abi_header_test
tests/test_posix
tests/churn_libspill
tests/test_surveyed
tests/test_crayio
tests/test_fortran
tests/test_crayio_i8
tests/test_cxx
tests/test_mapped
tests/test_exact_name
tests/test_hdf5
bench/ooc_bench
python/__pycache__/
.installcheck/
